{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Steeltoe": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=lab_netmicro_pricing;Username=postgres;Password=postgres;"
  },
  "eureka": {
    "client": {
      "serviceUrl": "http://localhost:8761/eureka/",
      "shouldRegisterWithEureka": true,
      "shouldFetchRegistry": true
    },
    "instance": {
      "hostName": "localhost",
      "port": 5001,
      "appname": "PricingService",
      "metadataMap": {
        "instanceId": "PricingService:localhost:5001"
      }
    }
  }
}
